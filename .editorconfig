# EditorConfig is awesome: http://EditorConfig.org

root = true

[*]
indent_style = tab
indent_size = 2
tab_width = 2
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf
charset = utf-8

# C source and header files
[*.{c,h}]
filetype = c
indent_style = space
indent_size = 2
tab_width = 2

[*.{cpp,cc,cxx,hpp,hxx}]
filetype = cpp
indent_style = space
indent_size = 2
tab_width = 2

# Makefiles must use tabs
[Makefile]
indent_style = tab
trim_trailing_whitespace = false

[.clang-tidy]
indent_style = space
indent_size = 2

# Markdown - preserve trailing whitespace (line breaks)
[*.md]
trim_trailing_whitespace = false

# Config files
[*.{cfg,ini,yml,yaml,json}]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = tab
indent_size = 2
tab_width = 2
